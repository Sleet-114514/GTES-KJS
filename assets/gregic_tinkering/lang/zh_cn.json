{
  "item.gregic_tinkering.wrench": "扳手",
  "item.gregic_tinkering.wrench.description": "扳手是一种用于操作和拆卸机器及管道的工具。\n它也用于合成中组装部件。",

  "item.gregic_tinkering.hammer": "锻造锤",
  "item.gregic_tinkering.hammer.description": "锻造锤用于合成中塑造金属、让机器静音，以及勘探矿石或洞穴。\n它也可以破坏方块，并在过程中将其打碎。",

  "item.gregic_tinkering.file": "锉",
  "item.gregic_tinkering.file.description": "锉是一种用于合成中通过去除材料来塑造物品的工具。",

  "item.gregic_tinkering.screwdriver": "螺丝刀",
  "item.gregic_tinkering.screwdriver.description": "螺丝刀是一种用于配置机器输出的工具。\n它也用于合成中拧紧螺丝。",

  "item.gregic_tinkering.saw": "锯",
  "item.gregic_tinkering.saw.description": "锯是一种用于切割木材和采集冰的工具。\n它也用于合成中切割物品。",

  "item.gregic_tinkering.wire_cutter": "剪线钳",
  "item.gregic_tinkering.wire_cutter.description": "剪线钳是一种用于操作和剪断电线的工具。\n它也用于合成中对金属进行精细切割。",

  "item.gregic_tinkering.crowbar": "撬棍",
  "item.gregic_tinkering.crowbar.description": "撬棍是一种用于撬开机器和管道盖板的工具。\n它也用于杀死头蟹。",

  "item.gregic_tinkering.soft_mallet": "软锤",
  "item.gregic_tinkering.soft_mallet.description": "软锤是一种用于切换机器激活状态的工具。\n它也用于合成中，当使用锤子会造成过大损伤时使用。",

  "item.gregic_tinkering.plunger": "搋子",
  "item.gregic_tinkering.plunger.description": "搋子是一种用于清除储罐中不需要的流体的工具。\n它也用于……消灭（EXTERMINATE）。",

  "item.gregic_tinkering.drill": "电钻",
  "item.gregic_tinkering.drill.description": "电钻是一种电动采矿工具。对泥土和岩石均有效，并且能大范围采集方块。\n需要能量才能运作。",

  "item.gregic_tinkering.chainsaw": "链锯",
  "item.gregic_tinkering.chainsaw.description": "链锯是一种电动伐木工具，能快速砍倒即使是最巨大的树木。\n需要能量才能运作。",

  "item.gregic_tinkering.powered_wrench": "电动扳手",
  "item.gregic_tinkering.powered_wrench.description": "电动扳手是一种用于操作和拆卸机器及管道的电动工具。\n它也用于合成中组装部件。\n需要能量才能运作。",

  "item.gregic_tinkering.powered_hammer": "气锤",
  "item.gregic_tinkering.powered_hammer.description": "气锤是一种用于合成中塑造金属、让机器静音，以及勘探矿石或洞穴的电动工具。\n它也可以破坏方块，并在过程中将其打碎。\n需要能量才能运作。",

  "item.gregic_tinkering.powered_file": "电动锉",
  "item.gregic_tinkering.powered_file.description": "电动锉是一种用于合成中通过去除材料来塑造物品的电动工具。\n需要能量才能运作。",

  "item.gregic_tinkering.powered_screwdriver": "电动螺丝刀",
  "item.gregic_tinkering.powered_screwdriver.description": "电动螺丝刀是一种用于配置机器输出的电动工具。\n它也用于合成中拧紧螺丝。\n需要能量才能运作。",

